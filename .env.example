# Variables d'environnement lues par docker-compose.yml et docker-compose.prod.yml.
# Copier en .env (jamais commité) puis renseigner les valeurs : cp .env.example .env
# Aucune valeur secrète ne doit figurer dans ce fichier.

# Nom de la base PostgreSQL.
# Facultative en production. Défaut (dev et prod) : backyard.
BASE_NOM=backyard

# Utilisateur de la base PostgreSQL.
# Facultative en production. Défaut (dev et prod) : backyard.
BASE_UTILISATEUR=backyard

# Mot de passe de la base PostgreSQL.
# OBLIGATOIRE et non vide en production : générer avec openssl rand -hex 24.
# Défaut en dev (sans surcharge de production) : backyard.
# N'est appliqué qu'à la création du volume donnees-postgres (voir docs/deploiement.md).
BASE_MOT_DE_PASSE=

# Version des images api et web tirées du registre ghcr.io, en production uniquement (docker-compose.prod.yml).
# OBLIGATOIRE en production, sans le « v » du tag : 0.5.0, ou 0.5.0-rc.1 pour une pré-version.
# Ignorée en dev et en E2E (les images y sont construites localement).
VERSION=0.5.0

# Nom de domaine servi en HTTPS par Caddy (certificat Let's Encrypt automatique).
# OBLIGATOIRE en production ; localhost pour un essai local (autorité interne de Caddy).
# Ignorée en dev (site servi en HTTP sur le port 80).
DOMAINE=localhost

# Limitation des tentatives de connexion (par pseudo, que le compte existe ou non).
# Facultatives. Entiers >= 1 : une valeur invalide (0, abc) empêche api de démarrer.
# Nombre d'échecs consécutifs avant blocage temporaire. Défaut : 5.
CONNEXION_ECHECS_MAX=5
# Durée du blocage en secondes, qui est aussi le délai d'oubli des échecs partiels. Défaut : 900 (15 min).
# Valeur basse (30) utile pour tester à la main.
CONNEXION_BLOCAGE_SECONDES=900

# Note : le blocage porte sur le pseudo, pas sur l'adresse IP. Un tiers qui connaît un pseudo (admin master compris)
# peut le bloquer temporairement ; les sessions déjà ouvertes ne sont pas touchées (voir docs/deploiement.md).

# Calculs Argon2id simultanés (connexion, création de compte, changement de mot de passe), environ 19 Mio chacun.
# Au-delà, attente d'une seconde au plus puis réponse 503 SERVICE_SATURE. Facultative. Entier >= 1 (sinon api ne démarre pas).
# Défaut : 4.
HACHAGE_CONCURRENCE_MAX=4

# Calculs Argon2id simultanés par adresse cliente, appliqué avant HACHAGE_CONCURRENCE_MAX : une seule IP ne peut pas
# occuper toutes les places (il en reste HACHAGE_CONCURRENCE_MAX moins cette valeur aux autres adresses).
# Facultative. Entier >= 1 (0, -1, abc : api ne démarre pas). Défaut : 1.
# À relever si des bénévoles derrière un même wifi reçoivent « service momentanément saturé » en se reconnectant.
# HACHAGE_CONCURRENCE_MAX_PAR_IP=1

# Drapeau Secure des cookies de session et CSRF (true ou false, toute autre valeur : api ne démarre pas).
# Facultative. Défaut : false avec docker-compose.yml (dev et E2E en HTTP) ; imposée à true par
# docker-compose.prod.yml (la valeur de .env y est ignorée).
# COOKIES_SECURE=false

# Limite de débit des routes publiques (accueil, suivi, logo : GET /api/courses et /api/courses/**), par IP et par
# minute (fenêtre fixe). Au-delà : 429 TROP_DE_REQUETES jusqu'à la minute suivante. Facultative.
# Entier >= 0, 0 = aucune limite ; une valeur invalide (abc, -1) empêche api de démarrer.
# Défaut : 1200. Un écran de suivi consomme ~20 requêtes/minute : 1200 admet ~60 écrans derrière une même IP
# (wifi d'un stade) tout en bloquant une boucle de requêtes. À remonter si plus de spectateurs partagent une IP.
BACKYARD_LIMITE_DEBIT_PUBLIC_PAR_MINUTE=1200

# Proxy de confiance pour X-Forwarded-For (IP retenue par la limite de débit et le plafond de hachage par IP) : fixé à `web` dans
# docker-compose.yml, non réglable par .env (la valeur ci-dessous serait ignorée). Documenté pour mémoire.
# BACKYARD_PROXY_DE_CONFIANCE=web

# Plafonds mémoire des conteneurs, en production seulement (docker-compose.prod.yml, mem_limit). Facultatives.
# Format Docker (512m, 1g). La JVM de api prend 60 % de API_MEMOIRE_MAX pour son tas.
# Défauts : 1g, 512m, 256m (1,75 Go au total, adapté à un VPS de 2 Go).
API_MEMOIRE_MAX=1g
BASE_MEMOIRE_MAX=512m
WEB_MEMOIRE_MAX=256m

# Admin master : compte unique, créé au démarrage de api s'il n'existe pas encore.
# OBLIGATOIRES en production ; facultatives en dev (vides : aucun admin master, avertissement dans les logs).
# Ignorées une fois l'admin master créé : les modifier ensuite n'a aucun effet (voir docs/deploiement.md).
# Une seule des deux renseignée, ou une valeur invalide : api ne démarre pas (le message cite la variable).
# Pseudo : 3 à 30 caractères (lettres, chiffres, « . », « _ », « - »), non utilisé par un autre compte.
ADMIN_MASTER_PSEUDO=
# Mot de passe initial : 12 à 128 caractères. Générer avec openssl rand -base64 18.
# Éviter le caractère $ (interpolé par Compose) ou le doubler ($$).
ADMIN_MASTER_MOT_DE_PASSE=

# Environnement et profil Spring : aucune variable à renseigner ici.
# BACKYARD_ENVIRONNEMENT est fixée à production par docker-compose.prod.yml : ne pas la définir à la main.
# SPRING_PROFILES_ACTIVE n'est jamais lue dans .env : le profil de test des E2E n'est activé que par
# docker-compose.e2e.yml (voir docs/deploiement.md, section « Tests E2E et profil e2e »).

# Données de démonstration (scripts/donnees-demo.sh) : variables lues par le script uniquement,
# ni par docker compose ni par api. À ne pas utiliser en production (voir docs/deploiement.md).
# Adresse de l'application visée. Défaut : http://localhost. Seuls localhost et 127.0.0.1 sont acceptés.
# BASE_URL=http://localhost
# « oui » autorise une autre cible que localhost (toute autre valeur est refusée). Jamais en production.
# DEMO_FORCER=
