# Variables d'environnement lues par docker-compose.yml et docker-compose.prod.yml.
# Copier en .env (jamais commité) puis renseigner les valeurs : cp .env.example .env
# Aucune valeur secrète ne doit figurer dans ce fichier.

# Nom de la base PostgreSQL.
# Facultative en production. Défaut (dev et prod) : backyard.
BASE_NOM=backyard

# Utilisateur de la base PostgreSQL.
# Facultative en production. Défaut (dev et prod) : backyard.
BASE_UTILISATEUR=backyard

# Mot de passe de la base PostgreSQL.
# OBLIGATOIRE et non vide en production : générer avec openssl rand -hex 24.
# Défaut en dev (sans surcharge de production) : backyard.
# N'est appliqué qu'à la création du volume donnees-postgres (voir docs/deploiement.md).
BASE_MOT_DE_PASSE=

# Nom de domaine servi en HTTPS par Caddy (certificat Let's Encrypt automatique).
# OBLIGATOIRE en production ; localhost pour un essai local (autorité interne de Caddy).
# Ignorée en dev (site servi en HTTP sur le port 80).
DOMAINE=localhost

# Identifiants de l'admin master créé au premier démarrage : ajoutés en 1.4 (à venir).
