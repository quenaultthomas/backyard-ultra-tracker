{
	# Pas d'API d'administration. HTTPS automatique actif uniquement pour un nom d'hôte :
	# le site par défaut :80 (dev, E2E) reste en HTTP sans redirection.
	admin off
	# Conteneur non root : pas d'installation de l'autorité locale dans le magasin système.
	skip_install_trust
}

# Adresse du site : :80 par défaut ; en production, ADRESSE_SITE=${DOMAINE} active HTTPS
# (Let's Encrypt, ou autorité interne pour localhost) et la redirection HTTP vers HTTPS.
{$ADRESSE_SITE::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Alias public de la santé du back : seul /actuator/health est joignable ainsi.
	handle /api/sante {
		# Appliqué à l'écriture : remplace un éventuel en-tête du back, y compris sur 502/504.
		header {
			Cache-Control no-store
			defer
		}
		rewrite * /actuator/health
		reverse_proxy api:8080
	}

	# Endpoints métier : relayés sans réécriture du chemin.
	handle /api/* {
		# Logo de course : 2 Mo refusés par l'api (413 ProblemDetail) ; au-delà de 4 Mio, Caddy répond lui-même 413
		# avant que Tomcat ne coupe la connexion sur un corps trop gros.
		request_body {
			max_size 4MiB
		}
		reverse_proxy api:8080
	}

	# Application Angular : fichiers statiques, repli sur index.html pour le routage.
	handle {
		root * /srv
		# Fichiers empreintes par le build (scripts, styles, police ; svg prévu par la charte) : contenu immuable.
		@ressourcesVersionnees path_regexp \-[A-Z0-9]{8}\.(js|css|woff2|svg)$
		header @ressourcesVersionnees Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}

# Site interne du healthcheck de production (le port 80 y redirige vers HTTPS).
# Écoute uniquement en local, jamais publié : sert la page d'accueil.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	root * /srv
	rewrite * /index.html
	file_server
}
