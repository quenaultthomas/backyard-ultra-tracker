{
	# Pas d'API d'administration ni de HTTPS automatique avant l'incrément 0.4.
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Alias public de la santé du back : seul /actuator/health est joignable ainsi.
	handle /api/sante {
		# Appliqué à l'écriture : remplace un éventuel en-tête du back, y compris sur 502/504.
		header {
			Cache-Control no-store
			defer
		}
		rewrite * /actuator/health
		reverse_proxy api:8080
	}

	# Endpoints métier : relayés sans réécriture du chemin.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Application Angular : fichiers statiques, repli sur index.html pour le routage.
	handle {
		root * /srv
		@ressourcesVersionnees path_regexp \-[A-Z0-9]{8}\.(js|css)$
		header @ressourcesVersionnees Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}
