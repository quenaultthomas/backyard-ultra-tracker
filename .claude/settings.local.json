{
  "permissions": {
    "allow": [
      "Bash(mvn compile:*)",
      "Bash(mvn test:*)",
      "Bash(mvn verify:*)",
      "Bash(mvn clean:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(git checkout:*)",
      "Bash(git pull --ff-only)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin feature/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(glab mr create:*)",
      "Bash(java -version)",
      "Bash(mvn -v)",
      "Bash(xargs -I{} sh -c 'echo \"== {}\"; cat {}')",
      "Bash(sort -u -t: -k3)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)",
      "Bash(glab mr merge:*)"
    ]
  }
}
